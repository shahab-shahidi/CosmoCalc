 RowBox[{
  RowBox[{
   RowBox[{"CalcSigma8", "[", "exp_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Liho1", ",", "Liho2", ",", "po", ",", "likeli", ",", "maxi1"}],
       "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Liho1", "=", 
       RowBox[{"ReadList", "[", 
        RowBox[{"\"\<~/CosmoCalc/Likelihood.txt\>\"", ",", "Number", ",", 
         RowBox[{"RecordLists", "\[Rule]", "True"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "1"}], ",", 
        RowBox[{"i", "\[LessEqual]", 
         RowBox[{"Length", "@", "Liho1"}]}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"Liho2", "[", "i", "]"}], "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Evaluate", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"-", 
                 RowBox[{"(", 
                  RowBox[{"1", "+", "z"}], ")"}]}], 
                RowBox[{
                 RowBox[{
                  RowBox[{"\[Delta]z", "'"}], "[", "z", "]"}], "/", 
                 RowBox[{"\[Delta]z", "[", "0", "]"}]}]}], "/.", "exp"}], 
              "]"}], "/.", 
             RowBox[{"z", "\[Rule]", 
              RowBox[{"Liho1", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "1"}], "]"}], "]"}]}]}], ")"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{
           RowBox[{"Liho1", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", 
           RowBox[{"Liho2", "[", "i", "]"}]}], "]"}], ";"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"po", "=", "0"}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "1"}], ",", 
        RowBox[{"i", "<", 
         RowBox[{"Length", "@", "Liho1"}]}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"po", "=", 
          RowBox[{
           RowBox[{"po", "+", 
            SuperscriptBox[
             RowBox[{"(", 
              FractionBox[
               RowBox[{
                RowBox[{"\[Sigma]8", " ", 
                 RowBox[{"Liho1", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "4"}], "]"}], "]"}]}], "-", 
                RowBox[{"Liho1", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "2"}], "]"}], "]"}]}], 
               RowBox[{"Liho1", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "3"}], "]"}], "]"}]], ")"}], "2"]}], "//", 
           "Simplify"}]}], ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"likeli", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{
           FractionBox[
            RowBox[{"-", "1"}], "2"], 
           RowBox[{"(", "po", ")"}]}], "]"}], "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{
             FractionBox[
              RowBox[{"-", "1"}], "2"], 
             RowBox[{"(", "po", ")"}]}], "]"}], "/.", 
           RowBox[{"\[Sigma]8", "\[Rule]", "0"}]}], ")"}]}], "//", 
        "Simplify"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"maxi1", "=", 
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{"likeli", ",", "\[Sigma]8"}], "]"}], "\[Equal]", "0"}], 
         ",", "\[Sigma]8"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{
       "\"\<The value for \!\(\*SuperscriptBox[SubscriptBox[\(\[Sigma]\), \(8\
\)], \(0\)]\) is calculated as: \>\"", ",", 
        RowBox[{"maxi1", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}]}], " ", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Return", "[", 
       RowBox[{"maxi1", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"plotSigma8", "=", 
       RowBox[{"Plot", "[", 
        RowBox[{"likeli", ",", 
         RowBox[{"{", 
          RowBox[{"\[Sigma]8", ",", 
           RowBox[{
            RowBox[{"maxi1", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}], "-", "0.1"}], 
           ",", 
           RowBox[{
            RowBox[{"maxi1", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}], "+", "0.1"}]}],
           "}"}], ",", 
         RowBox[{"AxesLabel", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{
           "\"\<\!\(\*SuperscriptBox[SubscriptBox[\(\[Sigma]\), \(8\)], \
\(0\)]\)\>\"", ",", "\"\<L\>\""}], "}"}]}], ",", 
         RowBox[{"PlotStyle", "\[Rule]", "Red"}]}], "]"}]}]}]}], 
