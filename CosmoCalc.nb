   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "pertur", ",", " ", "perturm", ",", " ", "exp1", ",", " ", "exp2", ",", 
       " ", "exp3", ",", " ", "exp4", ",", " ", "exp5"}], "}"}], ",", "\n", 
     "  ", 
     RowBox[{
      RowBox[{"Clear", "[", "Fieldeq", "]"}], ";", "\n", "  ", 
